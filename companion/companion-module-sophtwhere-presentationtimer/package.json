{
	"name": "companion-module-sophtwhere-presentationtimer",
	"version": "0.1.0",
	"main": "dist/main.js",
	"type": "module",
	"description": "Bitfocus Companion connection for the Presentation Timer (timer.sophtwhere.com): every timer command as actions, the timer's variables and states as variables and feedbacks",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"package": "npm run build && companion-module-build",
		"test": "npm run build && node --test \"dist/__tests__/*.test.js\""
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonathan-annett/timer-beta.git",
		"directory": "companion/companion-module-sophtwhere-presentationtimer"
	},
	"engines": {
		"node": "^22.20"
	},
	"dependencies": {
		"@companion-module/base": "~2.0.4",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.2",
		"@types/node": "^22.15.0",
		"@types/ws": "^8.5.13",
		"rimraf": "^6.0.1",
		"typescript": "~5.8.3"
	},
	"prettier": "@companion-module/tools/.prettierrc.json"
}
