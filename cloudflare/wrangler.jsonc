// The timer on Cloudflare: public/ as static files, README.md for the in-app help, and the pairing
// server (remote-server.js's protocol) as Durable Objects at /ws. Two deployments from this repo:
// alpha (the alpha branch; just the developer) and beta (main; the beta testers). Each has its own
// Durable Objects, so testing on alpha never touches a beta room.
//   npx wrangler dev                      local, http://localhost:8787/
//   npx wrangler deploy --env alpha|beta
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timed-show-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../public", "binding": "ASSETS", "html_handling": "none" },   // timer.html stays timer.html
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "CODES", "class_name": "Codes" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Codes"] }],
  "observability": { "enabled": true },
  "env": {
    "alpha": {
      "name": "timed-show-alpha",
      "routes": [{ "pattern": "alpha.timed-show.com", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "Room" },
          { "name": "CODES", "class_name": "Codes" }
        ]
      }
    },
    "beta": {
      "name": "timed-show-beta",
      "routes": [{ "pattern": "beta.timed-show.com", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "Room" },
          { "name": "CODES", "class_name": "Codes" }
        ]
      }
    }
  }
}
